%}


### E4) 약한 비밀번호로 회원가입 → 400 COMMON_001 + 필드 에러
POST {{baseUrl}}/api/v1/auth/signup/admin
Content-Type: application/json

{
  "loginId": "weakuser",
  "password": "short",
  "name": "약한 비번",
  "email": "weak@ttait.com"
}

> {%
    client.test("400 Bad Request", function() {
        client.assert(response.status === 400, "expected 400 but got " + response.status);
    });
    client.test("code is COMMON_001", function() {
        client.assert(response.body.code === "COMMON_001", "code mismatch: " + response.body.code);
    });
    client.test("password field error present", function() {
        client.assert(
            response.body.data && response.body.data.password,
            "expected password field error"
        );
    });
%}


### E5) loginId 중복 가입 시도 → 409 USER_002
POST {{baseUrl}}/api/v1/auth/signup/admin
Content-Type: application/json

{
  "loginId": "{{adminLoginId}}",
  "password": "{{adminPassword}}",
  "name": "중복 관리자",
  "email": "duplicate@ttait.com"
}

> {%
    client.test("409 Conflict", function() {
        client.assert(response.status === 409, "expected 409 but got " + response.status);
    });
    client.test("code is USER_002", function() {
        client.assert(response.body.code === "USER_002", "code mismatch: " + response.body.code);
    });
%}
