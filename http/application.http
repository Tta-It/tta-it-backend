    });
%}


### E-2) 관리자 토큰으로 제출 → 403 (role 불일치)
### 사전 조건: auth.http #1 이 실행되어 adminToken 이 저장돼 있어야 함
POST {{baseUrl}}/api/v1/company-admin/applications
Authorization: Bearer {{adminToken}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="industryType"

서비스업
--WebAppBoundary
Content-Disposition: form-data; name="employeeCount"

10
--WebAppBoundary
Content-Disposition: form-data; name="address"

테스트
--WebAppBoundary
Content-Disposition: form-data; name="files"; filename="business_registration.pdf"
Content-Type: application/pdf

< ./testfiles/business_registration.pdf
--WebAppBoundary--

> {%
    client.test("403 Forbidden", function() {
        client.assert(response.status === 403, "expected 403 but got " + response.status);
    });
%}


