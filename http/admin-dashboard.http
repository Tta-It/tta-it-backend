### D-0) 관리자 로그인 후 adminToken 저장
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "loginId": "{{adminLoginId}}",
  "password": "{{adminPassword}}"
}

> {%
    client.test("200 OK", function() {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
    client.test("role is ADMIN", function() {
        client.assert(response.body.data.role === "ADMIN", "role mismatch");
    });
    client.global.set("adminToken", response.body.data.accessToken);
%}


### D-1) 기본 기간으로 관리자 대시보드 조회
GET {{baseUrl}}/api/v1/admin/dashboard
Authorization: Bearer {{adminToken}}

> {%
    client.test("200 OK", function() {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
    client.test("summary exists", function() {
        client.assert(response.body.data.summary, "summary missing");
    });
    client.test("chart arrays exist", function() {
        client.assert(Array.isArray(response.body.data.regionUsages), "regionUsages not array");
        client.assert(Array.isArray(response.body.data.usageTrends), "usageTrends not array");
        client.assert(Array.isArray(response.body.data.topRegions), "topRegions not array");
        client.assert(Array.isArray(response.body.data.priorityRegions), "priorityRegions not array");
        client.assert(Array.isArray(response.body.data.pendingApplications), "pendingApplications not array");
    });
%}


### D-2) 기간 필터를 지정해서 관리자 대시보드 조회
GET {{baseUrl}}/api/v1/admin/dashboard?from=2025-01-01&to=2025-01-31
Authorization: Bearer {{adminToken}}

> {%
    client.test("200 OK", function() {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
    client.test("summary fields exist", function() {
        var s = response.body.data.summary;
        client.assert(typeof s.totalUsageCount === "number", "totalUsageCount missing");
        client.assert(typeof s.topRegionCount === "number", "topRegionCount missing");
        client.assert(typeof s.priorityReviewCount === "number", "priorityReviewCount missing");
        client.assert(typeof s.pendingApplicationCount === "number", "pendingApplicationCount missing");
    });
%}


### D-3) 잘못된 기간 조건 조회 시 400 응답 확인
GET {{baseUrl}}/api/v1/admin/dashboard?from=2025-02-01&to=2025-01-01
Authorization: Bearer {{adminToken}}

> {%
    client.test("400 Bad Request", function() {
        client.assert(response.status === 400, "expected 400 but got " + response.status);
    });
    client.test("code is COMMON_001", function() {
        client.assert(response.body.code === "COMMON_001", "code mismatch: " + response.body.code);
    });
%}


### E-D-1) 토큰 없이 조회 시 401 응답 확인
GET {{baseUrl}}/api/v1/admin/dashboard

> {%
    client.test("401 Unauthorized", function() {
        client.assert(response.status === 401, "expected 401 but got " + response.status);
    });
%}


### E-D-2) 잘못된 토큰으로 조회 시 401 응답 확인
GET {{baseUrl}}/api/v1/admin/dashboard
Authorization: Bearer invalid.token.value

> {%
    client.test("401 Unauthorized", function() {
        client.assert(response.status === 401, "expected 401 but got " + response.status);
    });
%}


### E-D-3) 기업 관리자 토큰으로 조회 시 403 응답 확인
### 사전 조건: 활성화된 기업 관리자 토큰을 {{acmeToken}}으로 저장
GET {{baseUrl}}/api/v1/admin/dashboard
Authorization: Bearer {{acmeToken}}

> {%
    client.test("403 Forbidden", function() {
        client.assert(response.status === 403, "expected 403 but got " + response.status);
    });
%}
