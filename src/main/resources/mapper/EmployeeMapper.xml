<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ttait.domain.employee.mapper.EmployeeMapper">

    <resultMap id="employeeResultMap" type="com.ttait.domain.employee.domain.Employee">
        <id property="id" column="id"/>
        <result property="organizationId" column="organization_id"/>
        <result property="userId" column="user_id"/>
        <result property="employeeNo" column="employee_no"/>
        <result property="name" column="name"/>
        <result property="email" column="email"/>
        <result property="department" column="department"/>
        <result property="position" column="position"/>
        <result property="employmentStatus" column="employment_status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="countByOrganizationId" resultType="long">
        SELECT COUNT(*)
        FROM t_employee
        WHERE organization_id = #{organizationId}
    </select>

    <select id="findByOrganizationId" resultMap="employeeResultMap">
        SELECT
            id,
            organization_id,
            user_id,
            employee_no,
            name,
            email,
            department,
            position,
            employment_status,
            created_at,
            updated_at
        FROM t_employee
        WHERE organization_id = #{organizationId}
        ORDER BY id
    </select>

    <select id="findNextIds" resultType="long">
        SELECT employee_seq.NEXTVAL
        FROM dual
        CONNECT BY LEVEL &lt;= #{count}
    </select>

    <insert id="insertAll">
        INSERT ALL
        <foreach collection="employees" item="employee">
            INTO t_employee (
                id,
                organization_id,
                user_id,
                employee_no,
                name,
                email,
                department,
                position,
                employment_status,
                created_at,
                updated_at
            ) VALUES (
                #{employee.id},
                #{employee.organizationId},
                #{employee.userId},
                #{employee.employeeNo},
                #{employee.name},
                #{employee.email},
                #{employee.department},
                #{employee.position},
                #{employee.employmentStatus},
                SYSTIMESTAMP,
                SYSTIMESTAMP
            )
        </foreach>
        SELECT 1 FROM dual
    </insert>
</mapper>
