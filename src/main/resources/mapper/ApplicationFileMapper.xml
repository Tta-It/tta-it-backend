<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ttait.domain.application.mapper.ApplicationFileMapper">

    <resultMap id="applicationFileResultMap" type="com.ttait.domain.application.domain.ApplicationFile">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="originalFileName" column="original_file_name"/>
        <result property="storedFileName" column="stored_file_name"/>
        <result property="filePath" column="file_path"/>
        <result property="fileSize" column="file_size"/>
        <result property="contentType" column="content_type"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="applicationFileColumns">
        id,
        user_id,
        original_file_name,
        stored_file_name,
        file_path,
        file_size,
        content_type,
        created_at
    </sql>

    <insert id="insert" parameterType="com.ttait.domain.application.domain.ApplicationFile">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT application_file_seq.NEXTVAL FROM dual
        </selectKey>
        INSERT INTO t_application_file (
            id,
            user_id,
            original_file_name,
            stored_file_name,
            file_path,
            file_size,
            content_type,
            created_at
        ) VALUES (
            #{id},
            #{userId},
            #{originalFileName},
            #{storedFileName},
            #{filePath},
            #{fileSize},
            #{contentType},
            SYSTIMESTAMP
        )
    </insert>

    <select id="findByUserId" parameterType="long" resultMap="applicationFileResultMap">
        SELECT <include refid="applicationFileColumns"/>
        FROM t_application_file
        WHERE user_id = #{userId}
        ORDER BY created_at DESC, id DESC
    </select>

    <select id="findById" parameterType="long" resultMap="applicationFileResultMap">
        SELECT <include refid="applicationFileColumns"/>
        FROM t_application_file
        WHERE id = #{id}
    </select>
</mapper>
