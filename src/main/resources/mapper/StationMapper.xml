<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ttait.domain.station.mapper.StationMapper">

    <select id="countAll" resultType="long">
        SELECT COUNT(*)
        FROM t_station
    </select>

    <delete id="deleteAll">
        DELETE FROM t_station
    </delete>

    <insert id="insertAll">
        INSERT ALL
        <foreach collection="stations" item="station">
            INTO t_station (
                station_code,
                station_name,
                district_name,
                detail_address,
                latitude,
                longitude,
                created_at,
                updated_at
            ) VALUES (
                #{station.stationCode},
                #{station.stationName},
                #{station.districtName},
                #{station.detailAddress},
                #{station.latitude},
                #{station.longitude},
                SYSTIMESTAMP,
                SYSTIMESTAMP
            )
        </foreach>
        SELECT 1 FROM dual
    </insert>
</mapper>
